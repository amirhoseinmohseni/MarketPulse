# Copy this file to .env and replace placeholders locally.
# Never commit .env or put real credentials in this file.

POSTGRES_DB=marketpulse
POSTGRES_USER=marketpulse
POSTGRES_PASSWORD=replace-with-a-strong-local-password

OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_TEMPERATURE=0.2
OPENROUTER_MAX_TOKENS=800
OPENROUTER_TIMEOUT_SECONDS=60
OPENROUTER_MAX_RETRY_ATTEMPTS=2
OPENROUTER_RETRY_BASE_DELAY_MILLISECONDS=500

DATA_COLLECTORS_FAIL_FAST=false
DATA_COLLECTORS_REDDIT_ENABLED=false
DATA_COLLECTORS_HACKERNEWS_ENABLED=true

HACKERNEWS_BASE_URL=https://hn.algolia.com/api/v1
HACKERNEWS_DEFAULT_LIMIT=20
HACKERNEWS_TAGS=story

REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=MarketPulse/1.0
REDDIT_AUTH_URL=https://www.reddit.com/api/v1/access_token
REDDIT_BASE_URL=https://oauth.reddit.com
REDDIT_DEFAULT_LIMIT=25
