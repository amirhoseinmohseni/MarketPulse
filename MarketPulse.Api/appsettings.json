{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "OpenRouter": {
    "ApiKey": "",
    "Model": "openrouter/auto",
    "Endpoint": "https://openrouter.ai/api/v1/chat/completions",
    "Temperature": 0.2,
    "MaxTokens": 800
  },
  "MarketInsightAnalysis": {
    "MaxItems": 20,
    "MaxIdeaLength": 500,
    "MaxSourceLength": 100,
    "MaxTitleLength": 240,
    "MaxContentLengthPerItem": 2000,
    "MaxTotalItemCharacters": 16000,
    "MinUsableTextLength": 20,
    "ModerateMinItems": 4,
    "ModerateMinSources": 2,
    "StrongMinItems": 10,
    "StrongMinSources": 3,
    "MinInsightCount": 1,
    "MaxInsightsPerCategory": 5,
    "MaxEvidencePerInsight": 5,
    "MaxSummaryLength": 2000,
    "MaxInsightTextLength": 1000
  },
  "DataCollectors": {
    "FailFast": false,
    "Sources": {
      "Reddit": {
        "Enabled": false
      },
      "HackerNews": {
        "Enabled": true
      }
    }
  },
  "HackerNews": {
    "BaseUrl": "https://hn.algolia.com/api/v1",
    "DefaultLimit": 20,
    "Tags": "story"
  },
  "Reddit": {
    "ClientId": "",
    "ClientSecret": "",
    "UserAgent": "MarketPulse/1.0",
    "AuthUrl": "https://www.reddit.com/api/v1/access_token",
    "BaseUrl": "https://oauth.reddit.com",
    "DefaultLimit": 25
  }
}
